{
  "name": "@postfmly/logger",
  "version": "1.0.16",
  "description": "Info/error console logger",
  "keywords": [
    "info",
    "error",
    "console",
    "logger"
  ],
  "homepage": "https://github.com/chump29/logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logger.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:browser": "bun build ./index.ts --outdir ./test --target browser --minify",
    "build:build": "bun run build.ts",
    "build:clean": "rimraf dist test/index.js",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bunx tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "build:rm": "rm -rf dist/build.d.ts dist/test",
    "clean": "rimraf bun.lock dist coverage",
    "clean:coverage": "rimraf coverage",
    "lint": "bun run lint:spell && bun run lint:biome",
    "lint:biome": "biome check --write --verbose .",
    "lint:spell": "cspell --verbose .",
    "prepare": "link-configs",
    "test": "bun run clean:coverage && bun test --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov",
    "test:browser": "bun run build:browser && bunx --bun serve test"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "dayjs": "^1.11.21",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "bun-scan": "^1.1.2",
    "cspell": "^10.0.0",
    "lcov-total": "^2.1.1",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.3.9"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true
}
