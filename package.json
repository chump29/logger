{
  "name": "@postfmly/logger",
  "version": "1.0.21",
  "description": "Info/error console logger",
  "keywords": [
    "info",
    "error",
    "console",
    "logger"
  ],
  "homepage": "https://github.com/chump29/logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logger.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:browser": "bun build ./index.ts --outdir ./test --target browser --minify",
    "build:build": "bun run build.ts",
    "build:clean": "bun run --bun rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bunx --bun tsgo --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "build:rm": "rm -rf dist/build.d.ts dist/test",
    "clean": "bun run --bun rimraf bun.lock dist coverage",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsgo",
    "prepare": "bun run --bun husky",
    "scan": "bunx --bun cve-lite-cli",
    "test": "bun test --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:browser": "bun run build:browser && bunx --bun serve test"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts}": "bun run --bun biome ci --no-errors-on-unmatched"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "dayjs": "^1.11.21",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260614.1",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.0.7",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.4.10"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true
}
