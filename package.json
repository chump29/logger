{
  "name": "@postfmly/logger",
  "version": "1.0.25",
  "description": "Info/error console logger",
  "keywords": [
    "info",
    "error",
    "console",
    "logger"
  ],
  "homepage": "https://github.com/chump29/logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logger.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:browser": "bun build ./index.ts --outdir ./tests --target browser --minify",
    "build:build": "bun run --bun build.ts",
    "build:clean": "bun run --bun rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bunx --bun tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "build:rm": "bun run --bun rimraf dist/build.d.ts dist/tests",
    "check": "bunx --bun depcheck --ignores=\"@types/*,bun,bun:*,lcov-total,rimraf\" || :",
    "clean": "bun run --bun rimraf bun.lock dist tests/coverage",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "bun run --bun husky",
    "scan": "bun run --bun cve-lite --check-overrides",
    "test": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:browser": "bun run build:browser && bunx --bun serve --single --no-clipboard tests"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts}": "bun run --bun biome ci --error-on-warnings --no-errors-on-unmatched"
  },
  "overrides": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "cspell": "10.0.1",
    "cve-lite-cli": "1.29.0",
    "globals": "17.10.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "dayjs": "^1.11.23",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.3.0",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.4.44"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true
}
