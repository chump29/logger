{
  "name": "@postfmly/logger",
  "version": "1.2.8",
  "description": "Info/error/variable console logger",
  "keywords": [
    "info",
    "error",
    "variable",
    "console",
    "logger"
  ],
  "homepage": "https://github.com/chump29/logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logger.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:test,lcov-total\"",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun husky",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bun run --bun cve-lite --check-overrides --check-network --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "test": "bun test --isolate --dots --bail --check",
    "test:coverage": "bun test --isolate --dots --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:coverage:full": "TEST_FULL=true bun test --isolate --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:full": "TEST_FULL=true bun test --isolate --bail --check",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --dot --no-must-find-files",
    "*.{json,md,ts}": "bun run --bun biome ci --error-on-warnings --no-errors-on-unmatched"
  },
  "overrides": {
    "undici-types": "8.12.4"
  },
  "dependencies": {
    "ansis": "^4.5.0",
    "browser-or-node": "^3.0.0",
    "colord": "^2.12.0",
    "dayjs": "^1.11.23",
    "sort-keys": "^6.0.1",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@postfmly/config": "^1.6.27",
    "bunup": "^0.16.32",
    "cve-lite-cli": "^1.41.1",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "engineStrict": true
}
