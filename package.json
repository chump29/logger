{
  "name": "@postfmly/logger",
  "version": "1.1.4",
  "description": "Info/error/variable console logger",
  "keywords": [
    "info",
    "error",
    "variable",
    "console",
    "logger"
  ],
  "homepage": "https://github.com/chump29/logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logger.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "check": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:test,lcov-total\"",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "bun run --bun husky",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:e18e",
    "scan:audit": "bun audit",
    "scan:cve": "bunx --bun cve-lite-cli --check-overrides --check-network --check-maintenance",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "test": "bun test --isolate --dots --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:full": "bun test --isolate --bail",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts}": "bun run --bun biome ci --error-on-warnings --no-errors-on-unmatched"
  },
  "overrides": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "chalk": "6.0.1",
    "cspell": "10.3.6",
    "globals": "17.13.0",
    "ini": "7.0.0",
    "strip-json-comments": "5.0.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "dayjs": "^1.11.23",
    "magic-regexp": "^0.11.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@postfmly/config": "^1.6.1",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "^1.4.2"
  },
  "engineStrict": true
}
